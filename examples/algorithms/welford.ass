// One-pass population variance. A record accumulator lowers to scalar locals.
fn update(s, x) = {
  let n = s.n + 1;
  let delta = x - s.mean;
  let mean = s.mean + delta / n;
  { n: n, mean: mean, m2: s.m2 + delta * (x - mean) }
};

export fn statistics(xs: [Num]) = {
  let s = xs |> fold({ n: 0, mean: 0, m2: 0 }, update);
  { count: s.n, mean: s.mean,
    variance: if s.n > 0 then s.m2 / s.n else 0,
    valid: s.n > 0 }
};
