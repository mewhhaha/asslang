{
  "name": "asslang-jte-prototype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Causal observation-typed Wasm kernels, composable scalar machines, ASABI 1 and capability effects",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:gradients": "node --test test/gradients.test.mjs test/differential.test.mjs test/experiments.test.mjs",
    "test:diagnostics": "node --test test/diagnostics*.test.mjs test/playground-diagnostics.test.mjs test/integration-entrypoints.test.mjs",
    "test:syntax": "node --test test/unary-syntax.test.mjs",
    "bench:syntax": "node scripts/bench-syntax.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "bench": "node scripts/bench.mjs",
    "demo": "node scripts/serve.mjs",
    "build:example": "node src/cli.mjs examples/energy.ass -o /tmp/asslang-energy.wasm --explain",
    "test:browser:http": "node scripts/browser-test.mjs --http",
    "bench:browser": "node scripts/browser-test.mjs --bench",
    "test:corpus": "node --test test/corpus.test.mjs",
    "example:host": "node examples/interop/host.mjs",
    "test:causal": "node --test test/causal.test.mjs test/leases.test.mjs",
    "bench:fusion": "node scripts/bench-fusion.mjs",
    "test:fusion": "node --test test/fusion*.test.mjs",
    "test:composability": "node --test test/fold-until.test.mjs test/reducers.test.mjs test/ergonomics.test.mjs",
    "example:reducers": "node examples/interop/reducers.mjs",
    "example:reconstruction": "node examples/interop/reconstruction.mjs",
    "bench:improvements": "node scripts/bench-improvements.mjs",
    "example:case-studies": "node examples/case-studies/run.mjs",
    "test:simd": "node --test test/simd.test.mjs test/expanded-corpus.test.mjs",
    "test:linearize": "node --test test/linearize.test.mjs test/differential.test.mjs test/gradients.test.mjs test/experiments.test.mjs",
    "test:pullback": "node --test test/pullback.test.mjs test/vjp.test.mjs test/linearize.test.mjs test/gradients.test.mjs test/differential.test.mjs test/experiments.test.mjs",
    "test:vjp": "node --test test/vjp.test.mjs test/differential.test.mjs test/gradients.test.mjs test/linearize.test.mjs test/experiments.test.mjs",
    "test:record-symbols": "node --test test/record-symbols.test.mjs test/experiments.test.mjs",
    "test:loop-budgets": "node --test test/reconstruction-loop-budgets.test.mjs test/loop-budgets.test.mjs test/loop-budgets-cli.test.mjs test/experiments.test.mjs",
    "example:descent": "node examples/interop/descent.mjs",
    "test:descent": "node --test test/descent.test.mjs test/descent-theory.test.mjs test/reconstruction.test.mjs test/reconstruction-loop-budgets.test.mjs",
    "example:descent-extension": "node examples/interop/descent-extension.mjs",
    "test:descent-extensions": "node --test test/descent-extension*.test.mjs test/descent.test.mjs test/descent-theory.test.mjs",
    "example:descent-query": "node examples/interop/descent-query.mjs",
    "test:descent-queries": "node --test test/descent-query*.test.mjs",
    "example:descent-batch": "node examples/interop/descent-batch.mjs",
    "test:descent-batches": "node --test test/descent-batch*.test.mjs",
    "example:evidence-residual": "node examples/interop/evidence-residual.mjs",
    "test:docs": "node --test test/documentation.test.mjs test/evidence-residual.test.mjs",
    "example:evidence-algebra": "node examples/interop/evidence-algebra.mjs",
    "test:evidence-algebra": "node --test test/evidence-algebra.test.mjs test/evidence-algebra-theory.test.mjs",
    "example:evidence-interface": "node examples/interop/evidence-interface.mjs",
    "test:evidence-interfaces": "node --test test/evidence-interface*.test.mjs",
    "example:evidence-refinement": "node examples/interop/evidence-refinement.mjs",
    "test:evidence-refinements": "node --test test/evidence-refinement*.test.mjs"
  }
}
